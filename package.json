{
  "name": "craft-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node tools/serve.mjs",
    "build": "tsc --noEmit && vite build && node tools/write_notices.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "svg-path-bbox": "^2.1.0",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.8",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
